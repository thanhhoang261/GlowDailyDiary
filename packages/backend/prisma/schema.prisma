datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String       @id @default(uuid())
  username         String       @unique
  passwordHash     String
  name             String
  avatarEmoji      String       @default("✨")
  targetDailyWords Int          @default(100)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  entries          DiaryEntry[]
}

model DiaryEntry {
  id             String   @id @default(uuid())
  userId         String
  date           String   // Format: YYYY-MM-DD
  title          String
  content        String
  mood           String   @default("joyful") // joyful, calm, energetic, grateful, reflective, tired, sad
  weather        String?  @default("sunny")
  vocabList      String?  // JSON stringified array of { word, meaning, example }
  gratitude      String?  // JSON stringified array of strings
  audioFilename  String?
  audioMimeType  String?
  audioDuration  Float?   // in seconds
  wordCount      Int      @default(0)
  promptQuestion String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}
